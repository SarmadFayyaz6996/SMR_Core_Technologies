# Public URL used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://smrcoretechnologies.com

# Optional: contact form submissions are POSTed as JSON to this endpoint
# (e.g. a CRM, Slack or email webhook). When unset, the form runs in demo mode.
CONTACT_WEBHOOK_URL=

# Search engine ownership verification (paste only the content="…" value).
# Google Search Console → Add property → URL prefix → "HTML tag" method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → "Meta tag" method.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Official social profiles. Leave empty until they exist — empty ones are hidden.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
# X handle including @, e.g. @smrcoretech
NEXT_PUBLIC_X_HANDLE=
