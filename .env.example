# Public URL used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://smrcoretechnologies.com

# Contact form email delivery (Resend — https://resend.com). REQUIRED in production:
# without RESEND_API_KEY (or CONTACT_WEBHOOK_URL) the form shows visitors an error
# instead of pretending their message was sent.
# Never put the real key in this file (it is committed to Git). Set it as a Secret in
# Cloudflare (Workers → Settings → Variables and Secrets) or in .env.local for local dev.
# Real keys start with "re_"; the key's *name* in the Resend dashboard is not the key.
RESEND_API_KEY=re_********************************
# Inbox that receives enquiries (defaults to info@smrcoretechnologies.com).
CONTACT_TO_EMAIL=info@smrcoretechnologies.com
# Sender address — must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=SMR Core Website <website@smrcoretechnologies.com>

# Optional: also POST each enquiry as JSON to this endpoint (CRM, Slack, Zapier…).
CONTACT_WEBHOOK_URL=

# Search engine ownership verification (paste only the content="…" value).
# Google Search Console → Add property → URL prefix → "HTML tag" method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → "Meta tag" method.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Official social profiles. Leave empty until they exist — empty ones are hidden.
# LinkedIn defaults to https://www.linkedin.com/company/smr-core-technologies/
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
# X handle including @, e.g. @smrcoretech
NEXT_PUBLIC_X_HANDLE=
